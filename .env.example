LLM_PROVIDER=anthropic
# Supported values: sarvam, openai, anthropic
LLM_FALLBACK_PROVIDER=openai
LLM_TIMEOUT_SECONDS=18
# Safe field-level grounding errors only; never prompts, keys, or raw data.
LLM_VALIDATION_DEBUG=false

SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Allows analytics-backed agent responses when no provider credentials are configured.
DEMO_MODE=false
